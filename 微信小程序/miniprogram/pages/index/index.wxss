/* 房间装修：把上面的骨架打扮好看 */

/* 整页：四边留点白，给个淡淡的底色 */
.page {
  padding: 30rpx;
  background-color: #f7f8fa;
  min-height: 100vh;   /* 至少占满一屏高 */
}

/* 大标题的打扮 */
.title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  color: #333333;
  margin: 20rpx 0 40rpx;
}

/* 6 个框排排坐：一行放 2 个，放不下自动换行 */
.box-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 每个数值框长这样 */
.box {
  width: calc(50% - 10rpx);     /* 每个框约占一半宽，中间留条缝 */
  margin-bottom: 20rpx;         /* 上下两排之间留点空 */
  background-color: #ffffff;    /* 白底 */
  border-radius: 20rpx;         /* 圆角，显得温柔 */
  padding: 30rpx 0;             /* 框里上下留白 */
  text-align: center;           /* 字居中 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06); /* 一点小影子，显得立体 */
}

/* 框里的小名字 */
.box-name {
  font-size: 26rpx;
  color: #888888;
}

/* 框里的大数值：又大又粗又醒目 */
.box-value {
  font-size: 60rpx;
  font-weight: bold;
  color: #1f6feb;
  margin-top: 10rpx;
}

/* 门铃按钮的打扮 */
.btn {
  margin-top: 40rpx;
  background-color: #1f6feb;  /* 蓝底 */
  color: #ffffff;             /* 白字 */
  border-radius: 999rpx;      /* 两头圆圆的，像胶囊 */
  font-size: 32rpx;
  padding: 20rpx 0;
}

/* 去掉微信按钮自带的灰色描边 */
.btn::after {
  border: none;
}

/* 连接状态那一行字 */
.status {
  text-align: center;     /* 居中 */
  font-size: 28rpx;
  color: #888888;         /* 没连上时是灰色 */
  margin-bottom: 24rpx;
}

/* 连上了就变绿色、加粗，一眼看出成功 */
.status.ok {
  color: #52c41a;
  font-weight: bold;
}

/* 开灯/关灯两个按钮排排坐：一行放两个 */
.btn-row {
  display: flex;
  margin-top: 40rpx;
}

/* 行里的按钮一人一半宽，去掉原来的上下间距 */
.btn-row .btn {
  flex: 1;
  margin-top: 0;
}

/* 开灯：橙色，像灯亮起来 */
.btn-on {
  background-color: #f5a623;
  margin-right: 16rpx;   /* 和关灯按钮之间留条缝 */
}

/* 关灯：灰色，像灯灭着 */
.btn-off {
  background-color: #6b7280;
}
