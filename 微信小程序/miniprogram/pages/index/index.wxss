/* 房间装修：浅青绿清新风 —— 每卡两行：上电压（蓝）下电流（橙） */

/* ===== 主色调板 =====
   页面底色  #e3f6f3 → #e9f7ef（浅青 → 浅绿渐变）
   电压蓝   #1f6feb
   电流橙   #ea580c
   成功绿   #16a34a
   ============================================ */

/* 整页：浅青到浅绿的柔和渐变底 */
.page {
  padding: 30rpx;
  background: linear-gradient(180deg, #e3f6f3 0%, #e9f7ef 55%, #eef9f4 100%);
  min-height: 100vh;
}

/* ===== 标题区 ===== */
.header {
  margin: 20rpx 0 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  color: #0f4c46;
  letter-spacing: 4rpx;
}

/* 副标题：小号淡字，青绿色调 */
.subtitle {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6b9e98;
  text-align: center;
  letter-spacing: 8rpx;
}

/* ===== 状态卡片：白底卡片，淡淡的青绿投影 ===== */
.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border: 1rpx solid rgba(15, 76, 70, 0.08);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 76, 70, 0.06);
}

/* 左半边：圆点 + 状态文字，排排坐 */
.status-left {
  display: flex;
  align-items: center;
}

/* 状态小圆点：没连上是浅灰 */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #c2cdc9;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 连上后圆点变绿、一呼一吸地发光（心跳动画） */
.dot-ok {
  background-color: #16a34a;
  animation: breath 1.6s ease-in-out infinite;
}

@keyframes breath {
  0%, 100% { box-shadow: 0 0 6rpx 2rpx rgba(22, 163, 74, 0.35); }
  50%      { box-shadow: 0 0 16rpx 5rpx rgba(22, 163, 74, 0.55); }
}

/* 状态文字 */
.status-text {
  font-size: 28rpx;
  color: #64748b;
}

/* 连上后文字变绿、加粗 */
.text-ok {
  color: #16a34a;
  font-weight: bold;
}

/* 右上角：最后更新时间，淡一点小一号 */
.status-time {
  font-size: 24rpx;
  color: #8aa39e;
}

/* ===== 6 个通道卡片：每张卡两行读数 ===== */

/* 排排坐：一行放 2 个，放不下自动换行 */
.box-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 每个数值卡片：白底圆角，浅色描边 */
.box {
  width: calc(50% - 10rpx);     /* 约占一半宽，中间留条缝 */
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border: 1rpx solid rgba(15, 76, 70, 0.06);
  border-radius: 24rpx;
  padding: 24rpx 20rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 16rpx rgba(15, 76, 70, 0.06);
}

/* 通道名：卡片顶部居中 */
.box-name {
  font-size: 26rpx;
  color: #0f4c46;
  font-weight: bold;
  text-align: center;
  margin-bottom: 12rpx;
}

/* 一行读数：左边小标签，右边数值+单位 */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 8rpx;
}

/* 行标签（电压/电流）：一粒小胶囊 */
.row-label {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.label-v {
  color: #1f6feb;
  background-color: rgba(31, 111, 235, 0.1);
  border: 1rpx solid rgba(31, 111, 235, 0.22);
}

.label-a {
  color: #ea580c;
  background-color: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

/* 行数值：右对齐，等宽感更强 */
.row-value {
  font-size: 42rpx;
  font-weight: bold;
  flex: 1;
  text-align: right;
  margin-right: 4rpx;
}

/* 电压读数：蓝 */
.value-v {
  color: #1f6feb;
}

/* 电流读数：橙 */
.value-a {
  color: #ea580c;
}

/* 单位：小一号、淡一点，跟在数值后面 */
.row-unit {
  font-size: 22rpx;
  font-weight: normal;
  color: #94a3b8;
  margin-left: 6rpx;
}

/* 设备疑似离线时：6 张卡整体变淡，提示"数据不可信" */
.stale .box {
  opacity: 0.45;
  transition: opacity 0.4s;
}

/* "等待设备上报数据……"提示：居中灰字 */
.hint {
  text-align: center;
  font-size: 26rpx;
  color: #748f8a;
  margin: 4rpx 0 8rpx;
}

/* 设备离线的警示提示：橙色 */
.hint-warn {
  color: #ea580c;
}

/* ===== 按钮 ===== */

/* 按钮通用样式：胶囊形 */
.btn {
  margin-top: 40rpx;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  background: linear-gradient(90deg, #1f6feb, #38bdf8);
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 235, 0.25);
}

/* 按下去的瞬间：轻轻缩小变透明，手感反馈 */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 已连接后按钮变灰，提示不用再点 */
.btn-gray {
  background: #aebfc0;
  box-shadow: none;
}

/* 没连上时，开灯/关灯按钮整个变淡，提示暂时不可用 */
.btn-disabled {
  opacity: 0.4;
}

/* 去掉微信按钮自带的灰色描边 */
.btn::after {
  border: none;
}

/* 开灯/关灯两个按钮排排坐：一行放两个 */
.btn-row {
  display: flex;
  margin-top: 30rpx;
}

/* 行里的按钮一人一半宽，去掉原来的上下间距 */
.btn-row .btn {
  flex: 1;
  margin-top: 0;
}

/* 开灯：橙色渐变，像灯亮起来 */
.btn-on {
  background: linear-gradient(90deg, #f59e0b, #fb923c);
  box-shadow: 0 8rpx 20rpx rgba(245, 158, 11, 0.28);
  margin-right: 16rpx;
}

/* 关灯：白底描边幽灵按钮，像灯灭着 */
.btn-off {
  background-color: #ffffff;
  border: 1rpx solid rgba(15, 76, 70, 0.25);
  color: #475569;
  box-shadow: none;
}
