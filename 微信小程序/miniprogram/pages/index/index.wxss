/* 房间装修：把上面的骨架打扮好看 */

/* 整页：浅灰底色，四边留白 */
.page {
  padding: 30rpx;
  background-color: #f2f4f8;
  min-height: 100vh;
}

/* 大标题 */
.title {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  color: #1f2937;
  margin: 20rpx 0 24rpx;
}

/* ===== 状态卡片：白底圆角，装着连接状态和更新时间 ===== */
.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 左半边：圆点 + 状态文字，排排坐 */
.status-left {
  display: flex;
  align-items: center;
}

/* 状态小圆点：没连上是灰色 */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #c0c4cc;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 连上后圆点变绿、微微发光 */
.dot-ok {
  background-color: #52c41a;
  box-shadow: 0 0 12rpx rgba(82, 196, 26, 0.7);
}

/* 状态文字 */
.status-text {
  font-size: 28rpx;
  color: #888888;
}

/* 连上后文字变绿、加粗 */
.text-ok {
  color: #52c41a;
  font-weight: bold;
}

/* 右上角：最后更新时间，淡一点小一号 */
.status-time {
  font-size: 24rpx;
  color: #9ca3af;
}

/* ===== 6 个通道卡片 ===== */

/* 排排坐：一行放 2 个，放不下自动换行 */
.box-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 每个数值卡片 */
.box {
  width: calc(50% - 10rpx);     /* 约占一半宽，中间留条缝 */
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 20rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
  border-top: 8rpx solid #e5e7eb;  /* 顶边默认灰色，收到数据后按类型变色 */
}

/* 电压卡片：蓝色顶边 + 淡蓝渐变底 */
.box-v {
  border-top-color: #1f6feb;
  background: linear-gradient(180deg, #eef4ff 0%, #ffffff 45%);
}

/* 电流卡片：橙色顶边 + 淡橙渐变底 */
.box-a {
  border-top-color: #f5a623;
  background: linear-gradient(180deg, #fff7ea 0%, #ffffff 45%);
}

/* 卡片头：通道名 + 类型标签 */
.box-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通道名 */
.box-name {
  font-size: 26rpx;
  color: #888888;
}

/* 类型小标签（电压/电流）：一粒小胶囊 */
.tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
}

.tag-v {
  background-color: #1f6feb;
}

.tag-a {
  background-color: #f5a623;
}

/* 卡片里的大数值 */
.box-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #374151;
  margin-top: 12rpx;
}

/* 电压的数值染成蓝色 */
.box-v .box-value {
  color: #1f6feb;
}

/* 电流的数值染成橙色 */
.box-a .box-value {
  color: #f5a623;
}

/* 单位：小一号、淡一点，跟在数值后面 */
.box-unit {
  font-size: 28rpx;
  font-weight: normal;
  color: #9ca3af;
  margin-left: 6rpx;
}

/* "等待设备上报数据……"提示：居中灰字 */
.hint {
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
  margin: 4rpx 0 8rpx;
}

/* ===== 按钮 ===== */

/* 按钮通用样式：胶囊形 */
.btn {
  margin-top: 40rpx;
  background-color: #1f6feb;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
}

/* 按下去的瞬间：轻轻缩小变透明，手感反馈 */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 已连接后按钮变灰，提示不用再点 */
.btn-gray {
  background-color: #9ca3af;
}

/* 没连上时，开灯/关灯按钮整个变淡，提示暂时不可用 */
.btn-disabled {
  opacity: 0.4;
}

/* 去掉微信按钮自带的灰色描边 */
.btn::after {
  border: none;
}

/* 开灯/关灯两个按钮排排坐：一行放两个 */
.btn-row {
  display: flex;
  margin-top: 30rpx;
}

/* 行里的按钮一人一半宽，去掉原来的上下间距 */
.btn-row .btn {
  flex: 1;
  margin-top: 0;
}

/* 开灯：橙色，像灯亮起来 */
.btn-on {
  background-color: #f5a623;
  margin-right: 16rpx;
}

/* 关灯：灰色，像灯灭着 */
.btn-off {
  background-color: #6b7280;
}
