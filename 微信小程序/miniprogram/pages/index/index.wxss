/* 房间装修：浅青绿清新风 —— 浅色渐变底 + 白卡片 + 清爽配色 */

/* ===== 主色调板 =====
   页面底色  #e3f6f3 → #e9f7ef（浅青 → 浅绿渐变）
   电压蓝   #1f6feb
   电流橙   #ea580c / #f59e0b
   成功绿   #16a34a
   ============================================ */

/* 整页：浅青到浅绿的柔和渐变底 */
.page {
  padding: 30rpx;
  background: linear-gradient(180deg, #e3f6f3 0%, #e9f7ef 55%, #eef9f4 100%);
  min-height: 100vh;
}

/* ===== 标题区 ===== */
.header {
  margin: 20rpx 0 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  color: #0f4c46;
  letter-spacing: 4rpx;
}

/* 副标题：小号淡字，青绿色调 */
.subtitle {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #6b9e98;
  text-align: center;
  letter-spacing: 8rpx;
}

/* ===== 状态卡片：白底卡片，淡淡的青绿投影 ===== */
.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #ffffff;
  border: 1rpx solid rgba(15, 76, 70, 0.08);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 76, 70, 0.06);
}

/* 左半边：圆点 + 状态文字，排排坐 */
.status-left {
  display: flex;
  align-items: center;
}

/* 状态小圆点：没连上是浅灰 */
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #c2cdc9;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 连上后圆点变绿、一呼一吸地发光（心跳动画） */
.dot-ok {
  background-color: #16a34a;
  animation: breath 1.6s ease-in-out infinite;
}

@keyframes breath {
  0%, 100% { box-shadow: 0 0 6rpx 2rpx rgba(22, 163, 74, 0.35); }
  50%      { box-shadow: 0 0 16rpx 5rpx rgba(22, 163, 74, 0.55); }
}

/* 状态文字 */
.status-text {
  font-size: 28rpx;
  color: #64748b;
}

/* 连上后文字变绿、加粗 */
.text-ok {
  color: #16a34a;
  font-weight: bold;
}

/* 右上角：最后更新时间，淡一点小一号 */
.status-time {
  font-size: 24rpx;
  color: #8aa39e;
}

/* ===== 6 个通道卡片 ===== */

/* 排排坐：一行放 2 个，放不下自动换行 */
.box-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* 每个数值卡片：白底圆角，浅色描边 */
.box {
  position: relative;
  width: calc(50% - 10rpx);     /* 约占一半宽，中间留条缝 */
  margin-bottom: 20rpx;
  background-color: #ffffff;
  border: 1rpx solid rgba(15, 76, 70, 0.06);
  border-radius: 24rpx;
  padding: 28rpx 20rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 6rpx 16rpx rgba(15, 76, 70, 0.06);
  overflow: hidden;             /* 让底部光条贴着卡片圆角 */
}

/* 电压卡片：顶部一层淡蓝晕染 */
.box-v {
  border-color: rgba(31, 111, 235, 0.22);
  background: linear-gradient(180deg, #eef6ff 0%, #ffffff 55%);
}

/* 电流卡片：顶部一层淡橙晕染 */
.box-a {
  border-color: rgba(245, 158, 11, 0.25);
  background: linear-gradient(180deg, #fff7ea 0%, #ffffff 55%);
}

/* 卡片头：通道名 + 类型标签 */
.box-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 通道名 */
.box-name {
  font-size: 26rpx;
  color: #6b7f7b;
}

/* 类型小标签（电压/电流）：一粒小胶囊 */
.tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.tag-v {
  color: #1f6feb;
  background-color: rgba(31, 111, 235, 0.1);
  border: 1rpx solid rgba(31, 111, 235, 0.25);
}

.tag-a {
  color: #ea580c;
  background-color: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
}

/* 卡片里的大数值 */
.box-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #334155;
  margin-top: 12rpx;
}

/* 没数据的占位 "--"：浅灰，别抢戏 */
.value-empty {
  color: #b6c4c0;
}

/* 电压的数值：饱和蓝，浅底上够醒目 */
.box-v .box-value {
  color: #1f6feb;
}

/* 电流的数值：饱和橙 */
.box-a .box-value {
  color: #ea580c;
}

/* 单位：小一号、淡一点，跟在数值后面 */
.box-unit {
  font-size: 28rpx;
  font-weight: normal;
  color: #94a3b8;
  margin-left: 6rpx;
}

/* 卡片底部光条：默认暗线，有数据后按类型点亮 */
.box-bar {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 16rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(15, 76, 70, 0.08);
}

.bar-v {
  background: linear-gradient(90deg, transparent, #38bdf8, transparent);
}

.bar-a {
  background: linear-gradient(90deg, transparent, #fb923c, transparent);
}

/* "等待设备上报数据……"提示：居中灰字 */
.hint {
  text-align: center;
  font-size: 26rpx;
  color: #748f8a;
  margin: 4rpx 0 8rpx;
}

/* ===== 按钮 ===== */

/* 按钮通用样式：胶囊形 */
.btn {
  margin-top: 40rpx;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 32rpx;
  padding: 20rpx 0;
  background: linear-gradient(90deg, #1f6feb, #38bdf8);
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 235, 0.25);
}

/* 按下去的瞬间：轻轻缩小变透明，手感反馈 */
.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 已连接后按钮变灰，提示不用再点 */
.btn-gray {
  background: #aebfc0;
  box-shadow: none;
}

/* 没连上时，开灯/关灯按钮整个变淡，提示暂时不可用 */
.btn-disabled {
  opacity: 0.4;
}

/* 去掉微信按钮自带的灰色描边 */
.btn::after {
  border: none;
}

/* 开灯/关灯两个按钮排排坐：一行放两个 */
.btn-row {
  display: flex;
  margin-top: 30rpx;
}

/* 行里的按钮一人一半宽，去掉原来的上下间距 */
.btn-row .btn {
  flex: 1;
  margin-top: 0;
}

/* 开灯：橙色渐变，像灯亮起来 */
.btn-on {
  background: linear-gradient(90deg, #f59e0b, #fb923c);
  box-shadow: 0 8rpx 20rpx rgba(245, 158, 11, 0.28);
  margin-right: 16rpx;
}

/* 关灯：白底描边幽灵按钮，像灯灭着；浅色底上字也要深色 */
.btn-off {
  background-color: #ffffff;
  border: 1rpx solid rgba(15, 76, 70, 0.25);
  color: #475569;
  box-shadow: none;
}
